PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="your_long_random_jwt_access_secret"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="your_long_random_jwt_refresh_secret"
JWT_REFRESH_EXPIRATION="7d"

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Security & Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
HEARTBEAT_THROTTLE_LIMIT=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Free LLM Chatbot (Google AI Studio)
GEMINI_API_KEY=your_free_gemini_api_key_from_google_ai_studio
